# === Base de datos ===
# Cadena de conexión completa a PostgreSQL
# Formato: postgres://usuario:password@host:puerto/nombre_db
DATABASE_URL=
# === Autenticación ===
# Secret usado para firmar los JWT. Genera uno único y seguro con:
#   openssl rand -base64 48
# NUNCA reutilices el mismo secret entre entornos (dev/producción)
JWT_SECRET=

# === Cookies ===
# Dominio donde se setea la cookie de sesión.
# En local, usa el dominio que configures en /etc/hosts (ver README)
# En producción, usa tu dominio raíz con punto al inicio, ej: .tudominio.com
COOKIE_DOMAIN=

# === CORS ===
# Origen exacto (protocolo + dominio + puerto) desde donde el frontend hace peticiones
# Dev:  http://login.tudominio.cl:4321
# Prod: https://login.tudominio.cl
FRONTEND_ORIGIN=

# === Servidor ===
PORT=4000
NODE_ENV=development

# === Seed (usuario admin inicial) ===
# Usados solo por `npm run db:seed`. Puedes eliminarlos después de correrlo una vez.
SEED_ADMIN_EMAIL=admin@tudominio.cl
SEED_ADMIN_PASSWORD=